{
  "name": "atlas-workspace-desktop",
  "version": "0.1.0",
  "description": "Atlas Workspace — desktop shell",
  "main": "main.js",
  "author": "Atlas",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.atlas.workspace",
    "productName": "AtlasWorkspace",
    "asar": true,
    "files": ["main.js", "package.json"],
    "extraResources": [
      { "from": "../workspace/atlas-workspace.exe", "to": "atlas-workspace.exe" },
      { "from": "../workspace/vendor/node-pty/package.json", "to": "vendor/node-pty/package.json" },
      { "from": "../workspace/vendor/node-pty/lib", "to": "vendor/node-pty/lib" },
      { "from": "../workspace/vendor/node-pty/prebuilds", "to": "vendor/node-pty/prebuilds" },
      { "from": "../workspace/vendor/node-pty/build", "to": "vendor/node-pty/build" },
      { "from": "../workspace/vendor/opencode", "to": "vendor/opencode" }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AtlasWorkspace",
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}

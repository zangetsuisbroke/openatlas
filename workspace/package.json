{
  "name": "atlas-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch server/index.ts",
    "build": "vite build",
    "embed": "bun scripts/embed-assets.mjs",
    "vendor": "bun scripts/vendor-opencode.mjs && bun scripts/vendor-node-pty.mjs",
    "check-clean": "bun scripts/check-clean.mjs",
    "check-exe": "bun scripts/check-clean.mjs --exe",
    "exe": "bun run build && bun run embed && bun run vendor && bun run check-clean && bun build --compile server/index.ts --outfile atlas-workspace.exe --minify && bun run check-exe",
    "start": "bun run build && bun server/index.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "d3-force": "^3.0.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4",
    "bun-types": "^1.3.14",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
